# ----------------------------
# Runtime application data
# ----------------------------

# Local hardware selections and solved projector/camera homographies.
# This file is generated/updated per machine.
config/settings.json

# Any future generated calibration files.
config/*calibration*.json
config/calibration/
calibration/

# Camera snapshots / debug captures / generated vision diagnostics.
captures/
snapshots/
debug_frames/
vision_debug/
calibration_frames/

# Recorded sessions / temporary games unless explicitly moved into source data.
sessions/
recordings/

